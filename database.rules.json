{
  "rules": {
    ".read": false,
    ".write": false,
    "public": {
      "setupComplete": {
        ".read": true,
        ".write": "auth != null && root.child('public').child('setupComplete').val() !== true && newData.val() === true"
      }
    },
    "alunosPorTurma": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
      ".write": false
    },
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin'))",
        ".write": "auth != null && ((auth.uid === $uid && root.child('public').child('setupComplete').val() !== true && newData.child('active').val() === true && newData.child('role').val() === 'admin') || (root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'admin'))"
      }
    }
  }
}
